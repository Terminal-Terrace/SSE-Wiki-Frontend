# 环境变量配置示例文件
# 复制此文件为 .env 并根据实际情况修改

# 当前应用地址（SSE-Wiki 主应用）
VITE_APP_URL=http://localhost:3000

# 认证前端应用地址
VITE_AUTH_APP_URL=http://localhost:3001

#TODO: 已弃用，待移除
# 主服务后端地址（处理除认证外的所有 API 请求）
VITE_MAIN_SERVICE_URL=http://localhost:8080

#TODO: 已弃用，待移除
# 认证服务后端地址（处理 /api/v1/auth 相关请求）
VITE_AUTH_SERVICE_URL=http://localhost:8081

# 认证 API 路径前缀（可选，默认 /api/v1/auth）
VITE_AUTH_API_PATH=/api/v1/auth

# API 请求超时时间（毫秒，可选，默认 10000）
VITE_API_TIMEOUT=10000

# ========== 文件上传配置 ==========

# OSS CDN 域名（用于拼接图片 URL）
# 示例：https://your-bucket.oss-cn-hangzhou.aliyuncs.com
VITE_OSS_CDN_BASE=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# Node.js Gateway 地址
# 默认：http://localhost:3002
VITE_GATEWAY_URL=http://localhost:3002