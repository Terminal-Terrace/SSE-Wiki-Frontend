{
  "name": "@terminal-terrace/sse-wiki",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build:local": "run-p type-check \"build-only {@}\" --",
    "build": "pnpm run build:local && wrangler deploy",
    "preview": "pnpm run build:local && wrangler dev",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint --ext .ts,.tsx,.vue src --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "deploy": "node ../../scripts/deploy-if-change.js"
  },
  "dependencies": {
    "@sse-wiki/ui": "workspace:*",
    "@sse-wiki/vue-rich-editor": "workspace:*",
    "@tiptap/core": "^3.7.2",
    "@tiptap/extension-code-block-lowlight": "^3.7.2",
    "@tiptap/extension-link": "^3.7.2",
    "@tiptap/extension-placeholder": "^3.7.2",
    "@tiptap/extension-typography": "^3.7.2",
    "@tiptap/pm": "^3.7.0",
    "@tiptap/starter-kit": "^3.7.0",
    "@tiptap/vue-3": "^3.7.0",
    "axios": "^1.6.0",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^0.544.0",
    "marked": "^16.4.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.1",
    "@vue/tsconfig": "^0.8.1",
    "depcheck": "^1.4.7",
    "jsdom": "^27.0.0",
    "npm-run-all2": "^8.0.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.92.1",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6",
    "wrangler": "^4.36.0"
  }
}
