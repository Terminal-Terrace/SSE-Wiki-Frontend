{
  "name": "terminal-terrace",
  "type": "module",
  "version": "1.0.0",
  "description": "终端露台前端大仓",
  "author": "",
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "scripts": {
    "lint": "eslint --ext .ts,.tsx,.vue . --fix",
    "prepare": "husky",
    "cz": "cz",
    "deploy": "pnpm -r run deploy",
    "postinstall": "pnpm --filter @sse-wiki/ui sync-exports && pnpm --filter @sse-wiki/ui build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.3.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.35.0",
    "eslint-plugin-format": "^1.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.36.0"
  }
}
